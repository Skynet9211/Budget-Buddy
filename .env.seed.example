# Used ONLY by `npm run seed:dev`. Copy to `.env.seed` (git-ignored) and point it at the DEV project.
SUPABASE_URL=https://your-dev-project-ref.supabase.co
# Dev project > Project Settings > API Keys > secret key (service_role). Never commit it, never put it in Netlify.
SUPABASE_SERVICE_ROLE_KEY=your-dev-secret-key
DEMO_EMAIL=demo@budgetbuddy.dev
DEMO_PASSWORD=change-me-demo-password
